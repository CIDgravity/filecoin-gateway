# copy to secrets.env and fill in real values.
# secrets.env is consumed by kustomize secretGenerator and must NOT
# be committed to git.
#
# wallet keys are binary and must be created separately:
#   kubectl create secret generic wallet-keys \
#     --from-file=/var/mnt/fgw/wallet/ \
#     -n filecoin-gateway

CIDGRAVITY_API_TOKEN=CHANGE_ME
RIBS_YUGABYTE_SQL_USER=yugabyte
RIBS_YUGABYTE_SQL_PASS=yugabyte
